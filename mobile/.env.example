# Mobile build-time configuration.
# Expo inlines every EXPO_PUBLIC_* value into the shipped bundle.
# For EAS builds, set these as EAS environment variables instead of committing them.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
EXPO_PUBLIC_BACKEND_URL=https://laso-backend.onrender.com/api/v1

# Optional. Required for the Android Google Maps provider map.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
