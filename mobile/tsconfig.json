{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "phosphor-react-native": ["./node_modules/phosphor-react-native/lib/typescript/index.d.ts"],
      "phosphor-react-native/lib/module/icons/*": ["./src/types/phosphor-icon.d.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "dist",
    "web-build",
    ".expo"
  ]
}
