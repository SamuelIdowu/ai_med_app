  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "start:prod": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "test": "jest --runInBand",
    "test:e2e": "npm run test:live",
    "test:live": "jest --config jest.live.config.js --runInBand",
    "test:load": "ts-node load-tests/run-benchmark.ts",
    "test:load:smoke": "k6 run load-tests/k6-smoke.js",
    "test:load:ramp": "k6 run load-tests/k6-concurrency-ramp.js",
    "test:load:journey": "k6 run load-tests/k6-user-journey.js",
    "test:mobile": "jest --config jest.mobile.config.js",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.86.2",
