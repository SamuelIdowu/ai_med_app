    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "expo-server-sdk": "^5.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "file-type": "^21.3.0",
    "helmet": "^8.1.0",
    "node-fetch": "^2.7.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0"
