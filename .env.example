# Laso Environment Configuration Template
# Duplicate this file to .env and populate with your project credentials.

# --- Supabase Database & Auth ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Alias used by the backend gateway (docker-compose.prod.yml and Render expect it).
SUPABASE_URL=https://your-project.supabase.co
# Server-only. Copy the current service_role / sb_secret key from Supabase.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# --- Backend Gateway Configuration ---
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API in production.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
# Example production value:
# ALLOWED_ORIGINS=https://app.laso.example

# --- ML Subsystem Bridge ---
# Production example: https://laso-ml.onrender.com or https://<user>-laso-ml.hf.space
ML_SERVICE_URL=http://localhost:8000
# Optional primary Overpass endpoint(s), comma-separated if desired.
# Use a paid or self-hosted endpoint for sustained production traffic.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Optional hosted Places fallback when Overpass is overloaded or returns no nearby facilities.
# Create a key at https://myprojects.geoapify.com/ and keep it server-side.
GEOAPIFY_API_KEY=
# REDIS_PASSWORD is required by docker-compose.prod.yml (no insecure fallback).
REDIS_URL=redis://:your_secure_redis_password@localhost:6379
REDIS_PASSWORD=your_secure_redis_password
# Comma-separated origins for the ML service; defaults to * for native clients.
CORS_ORIGINS=*

# --- Mobile Client Configuration ---
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000/api/v1

# --- AI Provider (chat + vision) ---
# Which registered provider the backend routes AI traffic to: gemini | openai.
AI_PROVIDER=gemini
# Optional model override per provider (defaults: gemini-2.5-flash / gpt-4o-mini).
# AI_MODEL=gemini-2.5-flash
# Base URL for OpenAI-compatible services (e.g. Azure, Groq, local gateways).
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini Medical Vision / LLM API ---
GEMINI_API_KEY=your_gemini_api_key

# --- OpenAI / OpenAI-compatible provider (used when AI_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key
