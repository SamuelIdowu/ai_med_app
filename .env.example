# Laso Environment Configuration Template
# Duplicate this file to .env and populate with your project credentials.

# --- Supabase Database & Auth ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Server-only. Copy the current service_role / sb_secret key from Supabase.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# --- Backend Gateway Configuration ---
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
# Comma-separated browser origins allowed to call the API in production.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
# Example production value:
# ALLOWED_ORIGINS=https://app.laso.example

# --- ML Subsystem Bridge ---
# Production example: https://laso-ml.onrender.com or https://<user>-laso-ml.hf.space
ML_SERVICE_URL=http://localhost:8000
# REDIS_PASSWORD is required by docker-compose.prod.yml (no insecure fallback).
REDIS_URL=redis://:your_secure_redis_password@localhost:6379
REDIS_PASSWORD=your_secure_redis_password
# Comma-separated origins for the ML service; defaults to * for native clients.
CORS_ORIGINS=*

# --- Mobile Client Configuration ---
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000/api/v1
# Optional. Leave empty to omit the Android Google Maps API key from builds.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Google Gemini Medical Vision / LLM API ---
GEMINI_API_KEY=your_gemini_api_key
