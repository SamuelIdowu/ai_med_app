# Laso Environment Configuration Template
# Duplicate this file to .env and populate with your project credentials.

# --- Supabase Database & Auth ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# --- Backend Gateway Configuration ---
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# --- ML Subsystem Bridge ---
ML_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_secure_redis_password

# --- Mobile Client Configuration ---
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000/api/v1

# --- Google Gemini Medical Vision / LLM API ---
GEMINI_API_KEY=your_gemini_api_key
